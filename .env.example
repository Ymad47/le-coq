# Le Coq Backend — Environment Variables
# Copy to .env and fill in values for your environment

# === Required ===

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/le_coq

# === Backend Server ===

# Bind address (default: 127.0.0.1:8000). Keep loopback; expose via a reverse proxy.
BIND_ADDRESS=127.0.0.1:8000

# API key — REQUIRED unless DISABLE_AUTH=true. Min 32 chars.
# Generate: openssl rand -hex 32
# Also read by the Vite dev proxy and the nginx frontend container.
LE_COQ_API_KEY=


# Logging level (default: le_coq=info,tower_http=debug)
RUST_LOG=le_coq=info,tower_http=debug

# === Python Integration ===

# Path to Python 3.11 binary for PyO3 (required — pydantic_core compiled for cp311)
# PYO3_PYTHON=/usr/bin/python3.11

# === Paths (optional — have sensible defaults) ===

# Project root directory, the one containing plugins/ (default: current directory)
# LE_COQ_ROOT=/opt/le-coq

# Le Chasseur output directory (defaults to LE_COQ_ROOT/le-chasseur/output)
# LE_CHASSEUR_OUTPUT_DIR=/opt/le-chasseur/output

# Plugins directory (defaults to LE_COQ_ROOT/plugins)
# LE_COQ_PLUGINS_DIR=/opt/le-coq/plugins

# Plugins venv site-packages (defaults to LE_COQ_PLUGINS_DIR/.venv/lib/python3.11/site-packages,
# used only if it exists)
# LE_COQ_PLUGINS_VENV=/opt/le-coq/plugins/.venv/lib/python3.11/site-packages

# === Plugin credentials (optional; those plugins fail with a clear error without them) ===
# ACLED_EMAIL=
# ACLED_PASSWORD=
# OPENCORPORATES_API_TOKEN=

# === Poller ===

# Poller scan interval in seconds (default: 300)
POLL_INTERVAL_SECS=300

# === Dev Only ===

# Disable authentication entirely — DEV ONLY. Refused at startup unless
# BIND_ADDRESS is a loopback address.
# DISABLE_AUTH=true
