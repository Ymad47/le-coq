[Unit]
Description=Le Coq Backend Service
After=network.target

[Service]
Type=simple
User=yaya
WorkingDirectory=/home/yaya/le-coq/backend
EnvironmentFile=/home/yaya/le-coq/backend/.env
Environment=RUST_LOG=info
ExecStart=/home/yaya/le-coq/target/debug/le-coq-backend
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target